NODE_ENV=development
# Pilot only: permit the public r2.dev delivery URL with production config.
# Keep false for normal launch; this does not bypass HTTPS, keys or bucket validation.
R2_ALLOW_DEV_PUBLIC_URL=false
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/just_pack_it_dev?replicaSet=rs0
CORS_ORIGINS=http://localhost:8081
# Generate independently, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_PEPPER=replace-with-an-independent-random-secret-at-least-32-characters
CURSOR_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12
LOG_LEVEL=info
# Separate expiry worker is opt-in; the HTTP server never starts it automatically.
INVENTORY_EXPIRY_WORKER_ENABLED=false
# COD activation is separate from the online payment/refund gates below.
ORDERS_COD_ENABLED=false
# Online payments are separately gated. Start with test keys, never frontend env secrets.
RAZORPAY_ENABLED=false
PAYMENT_RECOVERY_WORKER_ENABLED=false
RAZORPAY_REFUNDS_ENABLED=false
RAZORPAY_LIVE_ENABLED=false
# RAZORPAY_KEY_ID=rzp_test_yourKeyId
# RAZORPAY_KEY_SECRET=your-test-api-secret
# RAZORPAY_WEBHOOK_SECRET=your-independent-random-webhook-secret-at-least-32-characters
# Optional product photo uploads. Leave all three credentials unset to disable.
IMAGE_STORAGE_PROVIDER=cloudflare_images
# To use R2 instead, set IMAGE_STORAGE_PROVIDER=r2 and configure these plus CLOUDFLARE_ACCOUNT_ID.
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CLOUDFLARE_R2_BUCKET=justpackit-products
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://images.your-domain.com
# R2 Token value is not used by this S3 integration. Images token/hash are unnecessary in R2 mode.
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_IMAGES_API_TOKEN=your-account-scoped-images-write-token
# CLOUDFLARE_IMAGES_ACCOUNT_HASH=your-public-delivery-hash
# CLOUDFLARE_IMAGES_VARIANT=public
# Set only when running create-user; never store real values in this example.
# OPERATOR_PHONE=+910000000000
# OPERATOR_PASSWORD=replace-with-a-strong-unique-password
# OPERATOR_NAME=Local operator
# OPERATOR_ROLE=admin
# Optional browser push. Keep the JSON file out of Git and frontend bundles.
FIREBASE_PUSH_ENABLED=false
EMAIL_OTP_REQUIRED=true
GOOGLE_SIGN_IN_ENABLED=false
# Uses FIREBASE_PROJECT_ID and server-only GOOGLE_APPLICATION_CREDENTIALS.
# Run reviewed db:indexes before enabling Google sign-in.
# Optional temporary signup-send bypass for ONE test mailbox, expires automatically.
# EMAIL_OTP_TEST_RECIPIENT=your-test-mailbox@example.com
# EMAIL_OTP_TEST_UNTIL=2026-01-01T00:00:00Z
# Deadline must be in the next 24 hours. Daily quota and wrong-code limits remain.
# EMAIL_OTP_SECRET=generate-an-independent-random-secret-at-least-32-characters
# Brevo HTTPS API (not SMTP); sender must be verified/approved in Brevo.
# BREVO_API_KEY=your-brevo-api-key
# EMAIL_FROM=your-verified-sender@example.com
# FIREBASE_PROJECT_ID=your-firebase-project
# GOOGLE_APPLICATION_CREDENTIALS=D:/justpackit/just-back/secrets/firebase-service-account.json

# Opt-in platform dispatch. Configure/approve partners and coverage first.
PLATFORM_DELIVERY_ENABLED=false

# Optional seller photo-to-draft assistant (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
