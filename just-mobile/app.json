{
  "expo": {
    "name": "Just Pack It",
    "slug": "just-pack-it",
    "scheme": "justpackit",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-location", { "locationWhenInUsePermission": "Allow Just Pack It to find nearby shops and set your delivery pin." }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Just Pack It to select photos for your product listings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/just-pack-it-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.princeraj.justpackit",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/just-pack-it-adaptive.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d952500f-8128-4b94-97a9-b82d52d6c091"
      }
    },
    "owner": "vickyyadav12t",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d952500f-8128-4b94-97a9-b82d52d6c091"
    }
  }
}
